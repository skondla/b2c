# ── LLM Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Primary: Claude claude-sonnet-4-6
OPENAI_API_KEY=sk-...                  # Fallback / embeddings

# ── LangSmith Observability ───────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=b2c-mortgage-ai

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                    # development | pilot | production
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO

# ── Third-Party Integration Stubs ─────────────────────────────────────────────
# In production replace these with real credentials
CREDIT_BUREAU_API_KEY=sandbox-key
CREDIT_BUREAU_URL=https://sandbox.creditbureau.example.com
AUS_API_KEY=sandbox-key
AUS_URL=https://sandbox.aus.example.com
APPRAISAL_API_KEY=sandbox-key
PLAID_CLIENT_ID=sandbox
PLAID_SECRET=sandbox

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/mortgage.db

# ── Performance ───────────────────────────────────────────────────────────────
MAX_CONCURRENT_APPLICANTS=10000
PREQUAL_TIMEOUT_SECONDS=60
DOC_UPLOAD_MAX_MB=25
